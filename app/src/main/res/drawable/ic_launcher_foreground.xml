        android:pathData="M 23,26 
                          C 23,19 33,16 54,16 
                          C 75,16 85,19 85,26 
                          C 85,38 84,43 78,48 
                          C 72,53 62,53 58,45 
                          C 56,42 52,42 50,45 
                          C 46,53 36,53 30,48 
                          C 24,43 23,38 23,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="23"
                android:startY="16"
                android:endX="85"
                android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#00C4FF" />
                <item android:offset="0.45" android:color="#0096FF" />
                <item android:offset="1.0" android:color="#0066FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Center Camera / Sensor Pill -->
