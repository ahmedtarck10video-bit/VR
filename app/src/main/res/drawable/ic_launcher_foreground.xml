        android:pathData="M 49,20.5 
                          L 59,20.5 
                          A 3,3 0 0,1 62,23.5 
                          A 3,3 0 0,1 59,26.5 
                          L 49,26.5 
                          A 3,3 0 0,1 46,23.5 
                          A 3,3 0 0,1 49,20.5 Z"
        android:fillColor="#0052CC" />

    <!-- Smile Arc -->
    <path
        android:pathData="M 36,58 
                          C 40,73 68,73 72,58"
