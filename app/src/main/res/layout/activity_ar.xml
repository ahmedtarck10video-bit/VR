<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:sceneview="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ARSceneView from SceneView provides camera passthrough, renderer, and Filament integration -->
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/ar_scene_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        sceneview:enableDepth="true" />

    <!-- Overlay controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/place_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place"
            android:enabled="true" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFF"
            android:text="Initializing..."
            android:background="#66000000"
            android:padding="8dp" />
    </LinearLayout>

</FrameLayout>
